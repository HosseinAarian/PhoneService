<body class="bg-gradient-to-br from-gray-900 to-gray-800 min-h-screen">
	<div class="container mx-auto px-4 py-8">
		<!-- Header -->
		<div class="text-center mb-12">
			<h1 class="text-4xl font-bold text-white mb-4">📱 کاتالوگ گوشی موبایل</h1>
		</div>

		<!-- Brands Grid -->
		<div id="brandsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
			<div class="bg-gradient-to-br from-gray-700 to-gray-800 rounded-xl p-6 cursor-pointer transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl border border-gray-600"></div>
		</div>

		<!-- Phones List -->
		<div id="phonesContainer" class="hidden">
			<div class="flex items-center justify-between mb-6">
				<h2 id="selectedBrandTitle" class="text-2xl font-bold text-white"></h2>
				<button id="backButton" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
					بازگشت به برندها
				</button>
			</div>
			<div id="phonesList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				<!-- Phone cards will be populated by JavaScript -->
			</div>
		</div>
	</div>

	<script>
		// Phone data organized by brands
		const phoneDataModel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

		// DOM elements
		const brandsContainer = document.getElementById('brandsContainer');
		const phonesContainer = document.getElementById('phonesContainer');
		const phonesList = document.getElementById('phonesList');
		const selectedBrandTitle = document.getElementById('selectedBrandTitle');
		const backButton = document.getElementById('backButton');

		// Render brands
		function renderBrands() {
			brandsContainer.innerHTML = '';

				phoneDataModel.forEach(data => {
					const brandCard = document.createElement('div');
					brandCard.className = `bg-gradient-to-br from-gray-700 to-gray-800 rounded-xl p-6 cursor-pointer transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl border border-gray-600`;

					brandCard.innerHTML = `
						<div class="text-center">
							<div class="text-4xl mb-3">📱</div>
							<h3 class="text-xl font-semibold text-white mb-2">${data.PhoneBrandTitle}</h3>
						</div>
					`;

				brandCard.addEventListener('click', () => showPhones(data));
				brandsContainer.appendChild(brandCard);
			});
		}

		// Show phones for selected brand
		function showPhones(brandData) {
			selectedBrandTitle.textContent = `گوشی های ${brandData.PhoneBrandTitle}`;

			phonesList.innerHTML = '';

				const phones = {};
				brandData.ItemDTOs.forEach(item => {
					if (!phones[item.PhoneId]) {
						phones[item.PhoneId] = {
							phoneId: item.PhoneId,
							phoneTitle: item.PhoneTitle,
							services: []
						};
					}
						phones[item.PhoneId].services.push({
							serviceId: item.ServiceId,
							serviceTitle: item.ServiceTitle,
							itemId: item.ItemId,
							itemPrice: item.ItemPrice
						});
					});
						Object.values(phones).forEach(phone => {
			const phoneCard = document.createElement('div');
			phoneCard.className = 'bg-gray-800 rounded-lg p-5 shadow-md hover:shadow-lg transition-shadow border border-gray-700 mb-4';

			let servicesHtml = '';
			phone.services.forEach(svc => {
				servicesHtml += `
					<div class="flex justify-between text-sm text-gray-300 mb-1">
						<span>${svc.serviceTitle}</span>
						<span class="text-blue-400 font-bold">${svc.itemPrice} تومان</span>
					</div>
				`;
			});

			phoneCard.innerHTML = `
				<h4 class="font-semibold text-white text-lg mb-3">${phone.phoneTitle}</h4>
				<div>
					${servicesHtml}
				</div>
			`;

			phonesList.appendChild(phoneCard);
		});

		brandsContainer.classList.add('hidden');
		phonesContainer.classList.remove('hidden');
			}


		// function showPhones(brand) {
		// 	const brandData = phoneData[brand];
		// 	selectedBrandTitle.textContent = `گوشی های ${brand}`;

		// 	phonesList.innerHTML = '';
		// 	brandData.phones.forEach(phone => {
		// 		const phoneCard = document.createElement('div');
		// 		phoneCard.className = 'bg-gray-800 rounded-lg p-5 shadow-md hover:shadow-lg transition-shadow border border-gray-700';
		// 		phoneCard.innerHTML = `
		// 			<div class="flex items-center justify-between">
		// 				<div>
		// 					<h4 class="font-semibold text-white text-lg mb-2">${phone.title}</h4>
		// 					<p class="text-blue-400 font-bold text-xl">${phone.price}</p>
