<div dir="rtl" style="text-align: right;">
	@model IEnumerable<PhoneService.Core.Entities.Service>

	@{
		ViewData["Title"] = "Service";
	}

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

	<style>
		.btn {
			transition: all 0.3s ease;
			background-color: darkgray;
		}

			.btn:hover {
				transform: translateY(-2px);
				box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
			}
	</style>

	<p>
		<a class="btn btn-primary" href="@Url.Action("Create")">ثبت خدمت جدید</a>
	</p>

	<table class="table table-striped">
		<thead>
			<tr>
				<th>عنوان</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.Title</td>
					<td>
						<a class="btn btn-sm shadow rounded-pill px-3" href="@Url.Action("Edit", new { id = item.Id })">
							<i class="bi bi-pencil-square"></i> ویرایش
						</a>

						<a class="btn  btn-sm shadow rounded-pill px-3" href="@Url.Action("Delete", new { id = item.Id })">
							<i class="bi bi-trash"></i> حذف
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>