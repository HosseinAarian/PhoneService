@model PhoneService.Core.Entities.Phone

@{
    ViewData["Title"] = "Phone Details";
}

<h1>Phone Details</h1>

<div>
    <h4>Phone</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Brand</dt>
        <dd class="col-sm-10">@Model.PhoneBrand?.Title</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
